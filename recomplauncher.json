{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "OpenJamboree",
  "inputs": [
    {
      "id": "keys",
      "label": "Your prod.keys, dumped from your own Switch",
      "role": "key",
      "shared": "switch.prod-keys",
      "optional": false
    },
    {
      "id": "game",
      "label": "Your Super Mario Party Jamboree base game (.nsp, title 0100965017338000, version 0), dumped from your own Switch. It is read where it is: keep it there.",
      "role": "game",
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "update",
      "label": "Your Super Mario Party Jamboree update 2.3.0 (.nsp, version 458752), dumped from your own Switch",
      "role": "update",
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    }
  ],
  "prepare": {
    "program": ["python/python.exe", "launcher/prepare.sh"],
    "args": ["-u", "launcher/prepare.py", "--keys", "{input:keys}", "--base", "{input:game}", "--update", "{input:update}", "--data", "{data}"],
    "label": "Building the game from your copy (20 to 40 minutes the first time)",
    "done": ["{install}/games/openjamboree_build.json"]
  },
  "start": {
    "program": ["games/SuperMarioPartyJamboree.exe", "games/SuperMarioPartyJamboree"]
  },
  "folders": {
    "game": [{ "path": "{install}/games" }],
    "logs": [{ "path": "{install}/games" }],
    "saves": [{ "path": "{install}/games/SuperMarioPartyJamboree_data/save" }]
  },
  "saves": ["{install}/games/SuperMarioPartyJamboree_data/save"],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Where your saves are kept.", "open": "saves" },
    { "id": "game", "label": "Game folder", "help": "The built game, with its .ini and log.", "open": "game" }
  ]
}
